# Copy this file to .env. Never commit .env.
HOSTMGR_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate once with: openssl rand -base64 32
HOSTMGR_SECRET_KEY=replace-with-a-base64-encoded-32-byte-key

# Local UI demo (npm run demo)
HOSTMGR_MODE=demo
HOSTMGR_SECURE_COOKIE=false
HOSTMGR_SANDBOX_CLONE=false
PORT=3000
