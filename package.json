{
  "name": "modern-host-manager",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "description": "A constrained control plane for one self-managed Linux host.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.mjs",
    "demo": "node --env-file=.env src/server.mjs",
    "demo:reset-password": "node --env-file=.env scripts/reset-demo-password.mjs",
    "test": "node scripts/test-modules.mjs --all",
    "test:modules": "node scripts/test-modules.mjs",
    "test:module": "node scripts/test-modules.mjs",
    "test:watch": "node --test --watch",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:keygen": "node scripts/generate-update-key.mjs"
  }
}
